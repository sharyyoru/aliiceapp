# ============================================
# ALiice - Multi-Tenant Medical CRM & ERP
# Environment Variables
# ============================================

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ALiice

# Supabase project settings (replace with your new Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key for secure server-side operations only
# NEVER expose this in the browser!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider (e.g. OpenAI)
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Email service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@aliice.app
EMAIL_FROM_NAME=ALiice
EMAIL_REPLY_DOMAIN=aliice.app

# Stripe (legacy medical/patient invoice payments only)
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# Payrexx payment gateway (subscriptions + client invoices)
# Instance = the subdomain before .payrexx.com (e.g. 'aesthetics-ge' for aesthetics-ge.payrexx.com)
PAYREXX_INSTANCE=aesthetics-ge
# API secret from Payrexx dashboard > Integrations > API & Plugins
PAYREXX_API_SECRET=your-payrexx-api-secret

# Gmail integration (admin area — send from your real Gmail + sync replies)
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/gmail/callback

# WhatsApp Integration (optional)
WHATSAPP_API_URL=http://localhost:3001
WHATSAPP_API_KEY=your-whatsapp-api-key
